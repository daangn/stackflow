{
  "name": "@stackflow/plugin-history-sync",
  "version": "1.11.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/daangn/stackflow.git",
    "directory": "extensions/plugin-history-sync"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "yarn build:js && yarn build:dts",
    "build:dts": "tsc --emitDeclarationOnly",
    "build:js": "node ./esbuild.config.js",
    "clean": "rimraf dist",
    "dev": "yarn build:js --watch && yarn build:dts --watch && yarn test --watch",
    "test": "yarn jest",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "coveragePathIgnorePatterns": [
      "index.ts",
      "index.tsx"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "@swc/jest",
        {
          "jsc": {
            "transform": {
              "react": {
                "runtime": "automatic"
              }
            }
          }
        }
      ]
    }
  },
  "dependencies": {
    "flatted": "^3.3.1",
    "history": "^5.3.0",
    "react18-use": "^0.4.1",
    "url-pattern": "^1.0.3"
  },
  "devDependencies": {
    "@stackflow/config": "^2.0.0",
    "@stackflow/core": "^2.0.1",
    "@stackflow/esbuild-config": "^1.0.3",
    "@stackflow/plugin-renderer-basic": "^1.1.14",
    "@stackflow/react": "^2.1.0",
    "@swc/core": "^1.6.6",
    "@swc/jest": "^0.2.36",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.23.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^3.0.2",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "@stackflow/config": "^1.1.0 || ^2.0.0",
    "@stackflow/core": "^1.0.0 || ^2.0.0",
    "@stackflow/react": "^1.0.0 || ^2.0.0",
    "@types/react": ">=16.8.0",
    "react": ">=16.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "ultra": {
    "concurrent": [
      "dev",
      "build"
    ]
  }
}
